# Copy to .env. Replace all placeholders; never commit .env.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/soc_capstone"
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
REDIS_URL=redis://localhost:6379
AEGIS_SERVICE_URL=http://localhost:8000
AEGIS_SERVICE_SECRET=replace-with-at-least-32-random-characters
AEGIS_INTERNAL_KEY=replace-with-another-32-random-characters
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CHROMA_HOST=localhost
CHROMA_PORT=8001
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PLAYWRIGHT_TEST=false
